# Credenciales opcionales (solo en el entorno: GitHub → Settings → Secrets and variables → Actions, o un .env local
# que no va en git). Si faltan, el pipeline se salta esa fuente y la web funciona igual.

# GBIF (descargas SQL agregadas por cuadrícula para España): el nombre de usuario, no el email
GBIF_USUARIO=
GBIF_CLAVE=

# eBird API 2.0 (aves vistas en los últimos 30 días): https://ebird.org/api/keygen
EBIRD_CLAVE=
